# 서버 /data/dashboard/.env 에 복사해 값 채우기.
# global/config/config.go 의 환경변수 오버라이드가 .env.yml(production) 값을 덮어쓴다.
APP_MODE=production
DB_HOST=mariadb
DB_PORT=3306
DB_NAME=dashboard
DB_USER=dashboard
DB_PASS=dashboarddb
# 프론트 로그인용 액세스 키 (openssl rand -hex 24)
DASH_TOKEN=26028058835026d0fbffa819883240104f4f46dd5b04b1c7
# Health Auto Export 앱의 api-key 헤더 값 (openssl rand -hex 24)
HEALTH_INGEST_TOKEN=64e5b60cc8db14e83837aab14059952d2427d1f9457be3c7
# GitHub PAT (read:user) — Phase 2
GITHUB_TOKEN=
GITHUB_USERNAME=kobums
# GitLab PAT (read_api) — Phase 2
GITLAB_TOKEN=
GITLAB_USERNAME=
# snippet 계정 (독서 현황 프록시)
SNIPPET_EMAIL=
SNIPPET_PASSWORD=
# 알림 푸시 — 아침 9시/저녁 8시 스케줄러 (둘 다 비우면 발송 비활성, 조회형 API 는 유지)
# ntfy: iPhone ntfy 앱에서 같은 토픽 구독. 공개 ntfy.sh 는 토픽 이름이 곧 비밀번호 (openssl rand -hex 8 등으로 생성)
NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh
# 웹푸시(PWA) — webpush-go GenerateVAPIDKeys() 로 생성한 키페어
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=